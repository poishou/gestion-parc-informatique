rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' || request.auth.token.role == 'administrateur');
    }

    match /collaborateurs/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /equipements/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /stockMateriel/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /licences/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /affectations/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
